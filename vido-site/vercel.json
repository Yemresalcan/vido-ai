{
  "functions": {
    "pages/api/**/*.ts": {
      "runtime": "@vercel/node"
    }
  },
  "env": {
    "NEXT_PUBLIC_API_URL": "https://vido-ai-backend.fly.dev/generate_snippet_and_keywords"
  },
  "build": {
    "env": {
      "NEXT_PUBLIC_API_URL": "https://vido-ai-backend.fly.dev/generate_snippet_and_keywords"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
} 